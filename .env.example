# Optional. When set, /api/extract and /api/question may enrich the local deck with OpenAI.
OPENAI_API_KEY=

# Server-only. The extract, question, and grade routes read this. Never expose it to the browser.
ANTHROPIC_API_KEY=

# Set to fixtures to skip the model and serve local or canned questions.
# Leave unset to call Claude when ANTHROPIC_API_KEY is present.
DEMO_MODE=
